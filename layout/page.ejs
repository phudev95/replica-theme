<% var isEnabledSections = !['404 - Trang không tồn tại', 'search'].includes(page.title) %>

<div class="container-lg">
  <% if(isEnabledSections){ %>
    <%- partial('_partial/intro') %>
  <% } %>

  <div class="blog-detail">
    <% if(isEnabledSections){ %>
      <%- partial('_partial/navbar-secondary', {nav_selected: page.title}) %>
    <% } %>

    <div class="body-secondary">
      <% if(page.title === 'tags'){ %>
        <%- list_tags() %>
      <% } %>

      <% if(page.title === 'categories'){ %>
        <%- list_categories() %>
      <% } %>

      <% if(page.title === 'search'){ %>
        <%- partial('_partial/search') %>
      <% } %>

      <% if(page.title === '404 - Trang không tồn tại'){ %>
        <%- partial('_partial/404') %>
      <% } %>
    </div>
  </div>
</div>