<%
config.social = config.social || {};
theme.social = theme.social || {};
var github = config.social.github || theme.social.github;
var twitter = config.social.twitter || theme.social.twitter;
var linkedin = config.social.linkedin || theme.social.linkedin;
var facebook = config.social.facebook || theme.social.facebook;
var location = config.location || theme.location;
var url = config.url;
var flagcounter_href = config.flagcounter_href;
var flagcounter_img_src = config.flagcounter_img_src;
var currentYear = new Date().getUTCFullYear();
%>
<div class="footer-wrapper container">
  <footer class="footer clearfix">
    <div class="clearfix">
    <a href="<%= config.url %>" class="footer-logo">
      <img src="<%= config.logo %>" alt="<%= config.title %> logo" />
    </a>
    <ul class="footer-social-link">
      <li>© <%= currentYear %> <%= config.author %></li>
      <li><a href="<%= url %>">Home</a></li>
      <% if(github){ %>
      <li><a href="<%= github %>">Github</a></li>
      <% }if(twitter){ %>
      <li><a href="<%= twitter %>">Twitter</a></li>
      <% }if(linkedin){ %>
      <li><a href="<%= linkedin %>">Linkedin</a></li>
      <% }if(facebook){ %>
      <li><a href="<%= facebook %>">Facebook</a></li>
      <% } %>
    </ul>
    <div class="footer-theme-info">
      Theme <a href="//github.com/sabrinaluo/hexo-theme-replica">Replica</a>
      by <a href="//github.com/sabrinaluo">Hiitea</a> ❤ Powered by Hexo
    </div>
    </div>
    <% if(flagcounter_href && config.enabledScripts){ %>
    <div class="footer-pageview">
        <a href="<%= flagcounter_href %>" aria-label="Flag Counter - Visitor statistics">
          <img src="<%= flagcounter_img_src %>" alt="Flag Counter">
        </a>
    </div>
    <% } %>
  </footer>
</div>
