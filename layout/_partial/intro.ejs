<%
config.social = config.social || {};
theme.social = theme.social || {};
var github = config.social.github || theme.social.github;
var twitter = config.social.twitter || theme.social.twitter;
var linkedin = config.social.linkedin || theme.social.linkedin;
var facebook = config.social.facebook || theme.social.facebook;
var location = config.location || theme.location;
var email = config.email || theme.email;
var url = config.url;
var avatar = config.avatar || theme.avatar || 'https://octodex.github.com/images/baracktocat.jpg'
%>

<div class="blog-intro">
  <div class="blog-intro-user">
    <img class="avatar" src="<%= avatar %>" alt="<%= config.author %> avatar">
    <div class="user-name">
      <div class="blog-title"><%= config.title %></div>
      <div class="blog-author"><%= config.author %></div>
        <ul class="user-detail mobile-only">
    <% if(location){ %>
    <li>
      <i class="fa fa-map-marker"></i>
      <%= location %>
    </li>
    <% }if(email){ %>
    <li>
      <i class="fa fa-envelope-o"></i>
      <a href="mailto:<%= email %>"><%= email %></a>
    </li>
    <% } %>
    <li>
      <i class="fa fa-link"></i>
      <a href="<%= url %>"><%= url %></a>
    </li>
  </ul>
    </div>
    <div class="blog-description">
      <p>
        <%= config.description %>
      </p>

      <% if (config.other_site && config.other_site.url) { %>
      <p>
        <%= config.other_site.text %>
        <a href="<%= config.other_site.url %>" target="_blank">
          <%= config.other_site.name || config.other_site.url %>
        </a>
      </p>
      <% } %>
    </div>
  </div>

  <ul class="user-detail desktop-only">
    <% if(location){ %>
    <li>
      <i class="fa fa-map-marker"></i>
      <%= location %>
    </li>
    <% }if(email){ %>
    <li>
      <i class="fa fa-envelope-o"></i>
      <a href="mailto:<%= email %>"><%= email %></a>
    </li>
    <% } %>
    <li>
      <i class="fa fa-link"></i>
      <a href="<%= url %>"><%= url %></a>
    </li>
  </ul>

  <div class="social-media desktop-only">
    <h4>Social Media</h4>
    <ul>
      <% if(github){ %>
      <li class="social-media-item"><a href="<%= github %>" aria-label="Github" target="_blank"><i aria-hidden="true" class="fa fa-github"></i></a></li>
      <% } if(twitter){ %>
      <li class="social-media-item"><a href="<%= twitter %>" aria-label="Twitter" target="_blank"><i aria-hidden="true" class="fa fa-twitter"></i></a></li>
      <% } if(linkedin){ %>
      <li class="social-media-item"><a href="<%= linkedin %>" aria-label="LinkedIn" target="_blank"><i aria-hidden="true" class="fa fa-linkedin"></i></a></li>
      <% } if(facebook){ %>
      <li class="social-media-item"><a href="<%= facebook %>" aria-label="Facebook" target="_blank"><i aria-hidden="true" class="fa fa-facebook"></i></a></li>
      <% } %>
    </ul>
  </div>
</div>
