<%
var tags = page.tags ? page.tags.data : '';
var favicon = config.favicon || 'https://github.githubassets.com/favicon.ico';
%>
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <%- partial('_widget/title_description') %>
  <% if(tags){ %><meta name="keywords" content="<%= tags.map(function(tag) { return tag.name }).join(',') %>"><% } %>
  <meta name="author" content="<%= config.author %>">
  <meta http-equiv="Cache-Control" content="no-transform"/>
  <meta http-equiv="Cache-Control" content="no-siteapp">
  <meta name="theme-color" content="#1e2327">
  <link rel="canonical" href="<%= full_url_for(page.path.replace(/index\.html$/, '')) %>">
  <link rel="icon" type="image/x-icon" href="<%= favicon %>">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600&family=Source+Code+Pro">
  <link rel="stylesheet" href="<%= config.root %>lib/viewer/viewer.min.css">
  <link rel="stylesheet" href="<%= config.root %>css/main.css?r=2">
  <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml">
  <% if (config.enabledScripts) { %>
    <%- partial('_widget/google-analytics') %>
  <% } %>
  <% if (is_post()) { %>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "<%= page.title %>",
      "author": {
        "@type": "Person",
        "name": "<%= page.author || config.author %>"
      },
      "datePublished": "<%= page.date.format('YYYY-MM-DD') %>",
      "dateModified": "<%= page.updated.toISOString() %>",
      "description": "<%= page.description || config.description %>",
      "url": "<%= full_url_for(page.path.replace(/index\.html$/, '')) %>",
      "image": "<%= config.url + (page.cover || config.default_cover) %>"
    }
  </script>
  <% } %>
  <script src="//cdnjs.cloudflare.com/ajax/libs/vue/1.0.28-csp/vue.min.js"></script>
  <script src="//cdnjs.cloudflare.com/ajax/libs/moment.js/2.11.2/moment.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/raphael/2.2.8/raphael.min.js"></script>
</head>
