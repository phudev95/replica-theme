.post
  &-container
    border: $border-grey
    border-radius: 3px
    margin-bottom: 30px
    @media (max-width: $screen-sm)
      border-radius: 0
      border-right: none
      border-left: none
      border-top: none
    >h3
      background-color: $grey-lighter
      margin: 0
      padding: 10px 10px 10px
      font-size: 14px
      line-height: 17px
      border-bottom: 1px solid $grey-border
      border-radius(3px 3px 0 0)
      @media (max-width: $screen-sm)
        padding: 15px
  &-date
    font-size: 13px
    line-height: 20px
    color: #586069
    font-weight: normal

  &-content
    @media (max-width: $screen-sm)
      padding: 15px

    padding: 45px
    word-wrap: break-word
    font-family: $font-family-main
    font-size: 16px
    >*:first-child
      margin-top: 0 !important
    h1, h2, h3, h4, h5, h6
      font-weight: 600
      line-height: 1.25
      margin-top: 24px
      margin-bottom: 16px
    img
      max-width: 100%
    h1
      padding-bottom: 0.3em
      font-size: 2em
      border-bottom: $border-grey-light
    h2
      padding-bottom: 0.3em
      font-size: 1.75em
      border-bottom: $border-grey-light
    h3
      font-size: 1.5em
    h4
      font-size: 1.25em
    h5
      font-size: 1.1em
    p
      margin-top: 0
      margin-bottom: 16px

    code
      font-family: $font-family-code
      background: $bright-gray
      padding: 1px 7px
      border-radius: 6px

    .shiki
      code
        font-size: 0.9rem
        padding: 0
        border-radius: unset

    blockquote
      padding: 0 1em
      color: #6a737d
      border-left: 0.25em solid #dfe2e5
      margin: 0

    > table
      display: block
      width: 100%
      overflow: auto
      border-spacing: 0
      border-collapse: collapse
      tr
        border-top: 1px solid #c6cbd1
        &:nth-child(2n)
          background-color: $grey-lighter
      th, td
        padding: 6px 13px
        border: 1px solid #dfe2e5
      th
        font-weight: 600

    kbd
      display: inline-block;
      padding: 3px 5px;
      font-size: 11px;
      line-height: 10px;
      color: #444d56;
      vertical-align: middle;
      background-color: #fafbfc;
      border: solid 1px #c6cbd1;
      border-bottom-color: #959da5;
      border-radius: 3px;
      box-shadow: inset 0 -1px 0 #959da5;
